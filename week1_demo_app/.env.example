# true = Ollama, false = OpenRouter. Environment overrides config.toml.
LOCAL=true

# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_API_KEY=

# OpenRouter configuration: set LOCAL=false and supply your key/model.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Shared web search for BOTH Ollama and OpenRouter; obtain a key from tavily.com.
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=30

# Optional overrides; leave commented to use the templates in config.toml.
# MODEL_NAME=your-model-name
# SYSTEM_PROMPT="Your system prompt"
# USER_PROMPT="Discover {customer_name} using website {website_url}."
# REQUEST_TIMEOUT=120
